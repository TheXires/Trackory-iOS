    "%@" : {
      "comment" : "The title of the view, showing the name of the item. The argument is the name of the item.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A text field displaying the quantity of a medication in a user's cart. The text field has a fixed width.",
      "isCommentAutoGenerated" : true
    },
    "%lld / %lld kcal" : {
      "comment" : "Displays the actual and target calorie count for a specific day. The first argument is the count of calories consumed on that day. The second argument is the count of calories the user is aiming to consume on that day.",
